generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  name          String
  nameAr        String?
  nameEn        String?
  email         String?  @unique
  username      String?  @unique
  password      String
  role          String
  gender        String?
  age           Int?
  phone         String?
  parentPhone   String?
  hizbMemorized Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  parentId String?
  parent   User?   @relation("ParentChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children User[]  @relation("ParentChildren")

  teacherClasses   Class[]        @relation("TeacherClasses")
  classEnrollments ClassStudent[]

  attendances   Attendance[]
  memorizations Memorization[]

  sentMessages     Message[] @relation("MessageFrom")
  receivedMessages Message[] @relation("MessageTo")

  sentNotifications Notification[]
}

model AcademicYear {
  id        String   @id @default(uuid())
  name      String
  startDate String
  endDate   String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  classes       Class[]
  attendances   Attendance[]
  memorizations Memorization[]
}

model Class {
  id              String   @id @default(uuid())
  name            String
  sessionsPerWeek Int      @default(3)
  schedule        String   @default("[]")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  teacherId      String
  teacher        User         @relation("TeacherClasses", fields: [teacherId], references: [id])
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  students      ClassStudent[]
  attendances   Attendance[]
  memorizations Memorization[]
}

model ClassStudent {
  classId   String
  studentId String
  class     Class  @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User   @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([classId, studentId])
}

model Attendance {
  id        String   @id @default(uuid())
  date      String
  status    String   @default("present")
  createdAt DateTime @default(now())

  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, classId, date])
}

model Memorization {
  id         String   @id @default(uuid())
  date       String
  surahId    Int
  fromAyah   Int
  toAyah     Int
  evaluation String
  createdAt  DateTime @default(now())

  studentId      String
  student        User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classId        String
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYearId String
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id])
}

model Message {
  id        String   @id @default(uuid())
  message   String
  type      String   @default("private")
  chatId    String
  timestamp DateTime @default(now())

  fromId String
  from   User   @relation("MessageFrom", fields: [fromId], references: [id], onDelete: Cascade)
  toId   String
  to     User   @relation("MessageTo", fields: [toId], references: [id], onDelete: Cascade)

  @@index([chatId])
}

model Notification {
  id         String   @id @default(uuid())
  message    String
  senderName String
  timestamp  DateTime @default(now())
  readBy     String   @default("[]")

  senderId String
  sender   User   @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
